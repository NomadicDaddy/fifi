#!/bin/sh
# Leak-guard-only pre-commit, for repositories that cannot satisfy the full hook's script-name
# contract.
#
# The canonical pre-commit runs `bun run smoke:qc:fast`, and `bun run check:licenses` when
# a dependency manifest is staged. Those names are a contract, not an implementation: a carrier is
# free to define them however it likes. But a hook that calls a script the repository does not
# define fails EVERY commit instead of guarding it, and a hook that fails every commit gets
# uninstalled rather than fixed — taking the leak guard with it.
#
# So repositories with no package.json, or with no qc chain behind those two names, get this file
# instead. The security tier is identical: the same leak-guard.sh, byte-identical to every
# other carrier's, scanning the same staged index diff. Only the static checks are absent, and those
# were never the reason this hook exists.
#
# Installed by smokestack's scripts/install-leak-guard.ts, which picks between the two hooks by
# reading the target's package.json. Once a repository defines both names, re-running the installer
# replaces this file with the full hook.
#
# smokestack owns this file and delivers it with `bun run shared-core:write`. Change it in
# smokestack; every repository that takes it holds a byte-identical copy.

# Find bash by absolute path and put its directory first, then start over under it. Looking bash up
# on PATH is what broke this hook: on Windows System32 holds the WSL launcher under the same name,
# and a session whose PATH lists System32 ahead of Git's tools ran that, which fails with
# `execvpe(/bin/bash)`. A hook that fails every commit gets bypassed, and the leak guard goes with
# it. `/usr/bin/bash` is Git's own bash on Windows and the system's on Linux; `/bin/bash` covers
# macOS. With that directory first, every `bash`, `grep`, and `sort` below is the right one too.
if [ -z "${GITHOOK_BASH_RESOLVED:-}" ]; then
	for hook_bash in /usr/bin/bash /bin/bash; do
		if [ -x "$hook_bash" ]; then
			GITHOOK_BASH_RESOLVED=1
			PATH="${hook_bash%/*}:$PATH"
			export GITHOOK_BASH_RESOLVED PATH
			exec "$hook_bash" "$0" "$@"
		fi
	done
	echo "x pre-commit: no bash at /usr/bin/bash or /bin/bash, so the guards cannot run." >&2
	exit 1
fi
# Cleared so a git command run from inside this hook resolves bash for its own hooks afresh.
unset GITHOOK_BASH_RESOLVED

# From here on this runs under the bash the block above re-executed into. Plain shellcheck reads the
# #!/bin/sh line and lints the whole file as POSIX sh, so each bash-only line below says so.
# shellcheck disable=SC3040 # bash, after the re-exec above
set -euo pipefail

# The guard sits beside this hook: scripts/smokestack/hooks in a repository that takes it, and
# .githooks in smokestack itself.
hooks_dir="$(dirname "$0")"

# .aidd stays untracked in every repository (Phillip #21448). A repository with no push remote never
# runs the pre-push history guard, so this is what stops `git add -f` from tracking it again (#21477).
# It reads the index, so ignored .aidd files on disk never count, and it refuses only additions and
# changes: removing .aidd from the index is how a repository untracks it. Read into a variable so a
# pipe closed early under pipefail cannot skip it.
staged_aidd=$(git diff --cached --name-only --diff-filter=ACMRT -- ':(icase).aidd')
if [ -n "$staged_aidd" ]; then
	echo "x pre-commit: this commit stages .aidd metadata, which stays untracked in every repository:" >&2
	printf '%s\n' "$staged_aidd" | sed 's/^/    /' >&2
	echo "  Untrack it with: git rm -r --cached ':(icase).aidd'" >&2
	exit 1
fi

echo "pre-commit: leak-guard"
bash "$hooks_dir/leak-guard.sh"

# The repository's own pre-commit, kept in .githooks, runs after ours. git runs hooks from one
# folder, and in a repository that takes this file that folder is scripts/smokestack/hooks, so
# nothing else would run it. A file there carrying smokestack's ownership line is a delivered copy
# (in smokestack itself, this file), never the repository's own, and is not run.
own_hook=".githooks/$(basename "$0")"
if [ -f "$own_hook" ] && ! grep -q 'smokestack owns this file' "$own_hook"; then
	if [ -x "$own_hook" ]; then
		echo "pre-commit: $own_hook"
		"$own_hook" "$@"
	else
		echo "pre-commit: $own_hook is not executable, so it was not run" >&2
	fi
fi

echo "pre-commit: passed"
